{
  "version": 1,
  "unknownLevel": "execution_conformance",
  "rules": [
    {
      "level": "base",
      "patterns": [
        ".agents/**",
        ".claude/**",
        ".github/ISSUE_TEMPLATE/**",
        "apps/web/**",
        "docs/**",
        "tests/web/**",
        "*.md",
        "_config.yml",
        "skills-lock.json"
      ]
    },
    {
      "level": "extension_artifacts",
      "patterns": [
        ".github/workflows/**",
        "apps/extension/**",
        "LICENSE",
        "PRIVACY_POLICY.md",
        "THIRD_PARTY_DEPENDENCIES.json",
        "THIRD_PARTY_NOTICES.md",
        "package-lock.json",
        "package.json",
        "packages/browser-runtime/**",
        "packages/image-pipeline/**",
        "packages/model-manifest/**",
        "packages/shared-config/**",
        "packages/translator-core/**",
        "public/**",
        "scripts/**",
        "src/**",
        "tests/background/**",
        "tests/content/**",
        "tests/extension/**",
        "tests/offscreen/**",
        "tests/pipeline/**",
        "tests/popup/**",
        "tests/runtime/**",
        "tests/shared/**",
        "tests/translators/**",
        "tests/workers/**",
        "tools/web-ext/**",
        "tsconfig*.json",
        "vitest.config.ts"
      ]
    },
    {
      "level": "execution_conformance",
      "patterns": [
        ".github/workflows/**",
        "apps/extension/manifest/**",
        "apps/extension/package.json",
        "apps/extension/scripts/**",
        "apps/extension/src/capabilities/**",
        "apps/extension/src/ort/**",
        "apps/extension/src/pipelineHost/**",
        "apps/extension/vite.config.ts",
        "package-lock.json",
        "package.json",
        "packages/browser-runtime/**",
        "packages/image-pipeline/**",
        "packages/model-manifest/**",
        "packages/shared-config/**",
        "packages/translator-core/**",
        "public/fonts/**",
        "public/models/**",
        "public/ort/**",
        "scripts/build-worker.mjs",
        "scripts/check-paddle-ocr-model.mjs",
        "scripts/download-models.*",
        "scripts/prepare-runtime-ort-models.mjs",
        "scripts/vite-browser-runtime-boundary.ts",
        "src/background/**",
        "src/content/**",
        "src/offscreen/**",
        "src/pipeline/**",
        "src/runtime/**",
        "src/shared/**",
        "src/translators/**",
        "src/workers/**",
        "tests/background/**",
        "tests/content/**",
        "tests/extension/**",
        "tests/offscreen/**",
        "tests/pipeline/**",
        "tests/runtime/**",
        "tests/shared/**",
        "tests/translators/**",
        "tests/workers/**",
        "tools/web-ext/**",
        "tsconfig*.json",
        "vitest.config.ts"
      ]
    }
  ]
}
