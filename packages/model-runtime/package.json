{
  "name": "@shinobu/model-runtime",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./browser": {
      "types": "./src/browser.ts",
      "default": "./src/browser.ts"
    },
    "./node": {
      "types": "./src/node.ts",
      "default": "./src/node.ts"
    },
    "./worker": {
      "types": "./src/workers/onnx-worker.ts",
      "default": "./src/workers/onnx-worker.ts"
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@shinobu/browser-runtime": "0.1.0",
    "@shinobu/diagnostics": "0.1.0",
    "comlink": "^4.4.2",
    "onnxruntime-web": "^1.24.1"
  },
  "optionalDependencies": {
    "onnxruntime-node": "^1.26.0"
  }
}
