{
  "schema_version": 1,
  "browser": "firefox",
  "background": {
    "kind": "scripts",
    "scripts": [
      "background.js"
    ],
    "type": "module"
  },
  "gecko": {
    "id": "shinobu-translator@donutshinobu",
    "strict_min_version": "140.0",
    "data_collection_permissions": {
      "required": [
        "websiteContent"
      ],
      "optional": [
        "authenticationInfo"
      ]
    }
  },
  "gecko_android": {
    "strict_min_version": "142.0",
    "strict_max_version": "141.*"
  },
  "permission_overrides": {
    "required": {
      "add": [
        "menus"
      ],
      "remove": [
        "contextMenus"
      ]
    },
    "optional": {
      "add": [
        "cookies"
      ],
      "remove": []
    }
  }
}
